<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>
  <groupId>com.motorsure</groupId>
  <artifactId>motor-insurance-backend</artifactId>
  <version>0.1.0</version>
  <name>MotorSure backend parent</name>
  <description>Shared Spring Boot version, dependency management, and Maven plugin configuration for MotorSure services.</description>
  <packaging>pom</packaging>
  <modules>
    <module>services/quote-service</module>
    <module>services/policy-service</module>
    <module>services/claims-service</module>
  </modules>
  <properties>
    <java.version>21</java.version>
  </properties>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
